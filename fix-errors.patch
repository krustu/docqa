From 6e69c75165671cc18ce7a24dac4b0c0f45a0c6d6 Mon Sep 17 00:00:00 2001
From: Rysbek Dokturbaev <krustutysbek@gmail.com>
Date: Fri, 6 Nov 2026 01:01:15 +0100
Subject: [PATCH] Show real errors and handle empty Gemini answers

Gemini thinking models can spend the whole token budget on thinking and
return no text; raise the limit and report finishReason instead of failing
silently. Catch timeouts and unexpected errors in /api/ask, and show the
error text in the UI instead of an empty box.
---
 src/DocQa/Program.cs                |  9 +++++++++
 src/DocQa/Services/AnswerService.cs | 23 ++++++++++++++++++++---
 src/DocQa/wwwroot/index.html        |  7 ++++++-
 3 files changed, 35 insertions(+), 4 deletions(-)

diff --git a/src/DocQa/Program.cs b/src/DocQa/Program.cs
index bcb6e67..ffaf5dd 100644
--- a/src/DocQa/Program.cs
+++ b/src/DocQa/Program.cs
@@ -85,6 +85,15 @@ app.MapPost("/api/ask", async (AskRequest body, AnswerService answers, Cancellat
     {
         return Results.Problem(ex.Message, statusCode: 502);
     }
+    catch (TaskCanceledException) when (!ct.IsCancellationRequested)
+    {
+        return Results.Problem("The AI model did not answer within 60 seconds. Try again.", statusCode: 504);
+    }
+    catch (Exception ex)
+    {
+        app.Logger.LogError(ex, "Ask failed");
+        return Results.Problem("Unexpected error: " + ex.Message, statusCode: 500);
+    }
 });
 
 // Load the files from ./samples on startup so the demo works right away.
diff --git a/src/DocQa/Services/AnswerService.cs b/src/DocQa/Services/AnswerService.cs
index d9b04a6..524f47b 100644
--- a/src/DocQa/Services/AnswerService.cs
+++ b/src/DocQa/Services/AnswerService.cs
@@ -79,7 +79,7 @@ public sealed class AnswerService
         {
             system_instruction = new { parts = new[] { new { text = SystemPrompt } } },
             contents = new[] { new { role = "user", parts = new[] { new { text = prompt } } } },
-            generationConfig = new { maxOutputTokens = 800 }
+            generationConfig = new { maxOutputTokens = 4096 }
         };
 
         var url = $"https://generativelanguage.googleapis.com/v1beta/models/{_geminiModel}:generateContent";
@@ -87,8 +87,25 @@ public sealed class AnswerService
         req.Headers.Add("x-goog-api-key", _geminiKey);
 
         using var doc = await SendAsync(req, "Gemini", ct);
-        var parts = doc.RootElement.GetProperty("candidates")[0].GetProperty("content").GetProperty("parts");
-        return string.Concat(parts.EnumerateArray().Select(p => p.TryGetProperty("text", out var t) ? t.GetString() : ""));
+
+        // Thinking models can return a candidate without text (e.g. token limit hit
+        // while "thinking", or blocked by safety), so read the response defensively.
+        if (!doc.RootElement.TryGetProperty("candidates", out var candidates) || candidates.GetArrayLength() == 0)
+            throw new InvalidOperationException("Gemini returned no answer: " + Shorten(doc.RootElement.ToString(), 300));
+
+        var candidate = candidates[0];
+        var text = "";
+        if (candidate.TryGetProperty("content", out var content) && content.TryGetProperty("parts", out var parts))
+            text = string.Concat(parts.EnumerateArray()
+                .Where(p => !(p.TryGetProperty("thought", out var th) && th.ValueKind == JsonValueKind.True))
+                .Select(p => p.TryGetProperty("text", out var t) ? t.GetString() : ""));
+
+        if (string.IsNullOrWhiteSpace(text))
+        {
+            var reason = candidate.TryGetProperty("finishReason", out var r) ? r.GetString() : "unknown";
+            throw new InvalidOperationException($"Gemini returned an empty answer (finishReason: {reason}).");
+        }
+        return text;
     }
 
     private async Task<string> AskClaudeAsync(string prompt, CancellationToken ct)
diff --git a/src/DocQa/wwwroot/index.html b/src/DocQa/wwwroot/index.html
index c46d526..a1065f8 100644
--- a/src/DocQa/wwwroot/index.html
+++ b/src/DocQa/wwwroot/index.html
@@ -66,7 +66,12 @@ async function api(url, opts = {}) {
     opts.headers = { ...(opts.headers || {}), 'X-Access-Code': code };
     r = await fetch(url, opts);
   }
-  if (!r.ok) throw new Error((await r.text()) || r.statusText);
+  if (!r.ok) {
+    const body = await r.text();
+    let msg = body;
+    try { const j = JSON.parse(body); msg = j.detail || j.title || body; } catch {}
+    throw new Error(msg || `Request failed (HTTP ${r.status})`);
+  }
   return r;
 }
 
